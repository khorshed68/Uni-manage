# Copy this file to .env and change the values. Docker Compose reads .env automatically.

APP_PORT=9090

POSTGRES_DB=ums
POSTGRES_USER=ums
POSTGRES_PASSWORD=change_this_db_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION=PT1H

# First admin account (created only if the database has no admin yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@university.edu

# Creates demo users teacher1/Teacher@123 and student1/Student@123
SEED_DEMO_DATA=true
